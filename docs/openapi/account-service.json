        },
        "security": [],
        "summary": "Refresh access token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Creates a new bank account (balance 0, default daily limit Rp 50.000.000) and user credentials. Returns JWT access and refresh tokens",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Registered; tokens returned"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request: validation failed or a parameter is malformed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [],
        "summary": "Register a new user",
        "tags": [
          "Authentication"
        ]
      }
    }
  },
  "security": [
    {
      "Bearer Authentication": []
    }
  ],
  "servers": [
    {
      "description": "Generated server url",
      "url": "http://localhost:8081"
    }
  ],
  "tags": [
    {
      "description": "User registration, login, token refresh, and logout",
      "name": "Authentication"
    },
    {
      "description": "Account management — create, retrieve, and query bank accounts",
      "name": "Account"
    }
  ]
}
