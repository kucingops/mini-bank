                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [],
        "summary": "Login",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revokes all refresh tokens for the authenticated user",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Logged out; refresh tokens revoked"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request: validation failed or a parameter is malformed"
          },
          "401": {
            "content": {
              "application/json": {
