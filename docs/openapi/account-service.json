            "description": "Invalid request: validation failed or a parameter is malformed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authenticated, but not allowed to access this resource"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Resource not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "summary": "Find account by account number",
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/accounts/{id}": {
      "get": {
        "description": "Retrieves a single account. USER can only read their own account; ADMIN can read any",
        "operationId": "getAccount",
        "parameters": [
          {
            "description": "Account ID",
            "example": "3f1c2a9e-8b7d-4c3a-9e2f-1a2b3c4d5e6f",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
