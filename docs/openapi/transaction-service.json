{
  "components": {
    "schemas": {
      "DailyAverageBalance": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "accountNumber": {
            "type": "string"
          },
          "averageDailyBalance": {
            "type": "number"
          },
          "closingBalance": {
            "type": "number"
          },
          "holderName": {
            "type": "string"
          },
          "openingBalance": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Standard error body",
        "properties": {
          "error": {
            "description": "HTTP reason phrase",
            "example": "Forbidden",
            "type": "string"
          },
          "message": {
            "description": "Human-readable explanation",
            "example": "You do not have access to this account",
            "type": "string"
          },
          "path": {
            "description": "Request path",
            "example": "/api/v1/accounts/3f1c2a9e-8b7d-4c3a-9e2f-1a2b3c4d5e6f",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 403,
            "format": "int32",
            "type": "integer"
          },
          "timestamp": {
            "description": "When the error happened (server time)",
            "format": "date-time",
            "type": "string"
          }
        }
      },
      "PageResponseTransferResponse": {
        "description": "One page of results",
        "properties": {
          "content": {
            "description": "Items on this page",
            "items": {
              "$ref": "#/components/schemas/TransferResponse"
            },
            "type": "array"
          },
          "page": {
            "description": "Zero-based page index",
            "example": 0,
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "description": "Requested page size",
            "example": 20,
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "description": "Total number of items across all pages",
            "example": 42,
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "description": "Total number of pages",
            "example": 3,
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ReconciliationReport": {
        "properties": {
          "averageBalances": {
            "items": {
              "$ref": "#/components/schemas/DailyAverageBalance"
            },
            "type": "array"
          },
          "completedTransactions": {
            "format": "int32",
            "type": "integer"
          },
          "pendingTransactions": {
            "format": "int32",
            "type": "integer"
          },
          "rejectedTransactions": {
            "format": "int32",
            "type": "integer"
          },
          "reportDate": {
            "format": "date",
            "type": "string"
          },
          "totalAmountTransferred": {
            "type": "number"
          },
          "totalTransactions": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TransferRequest": {
        "description": "Fund transfer request",
        "properties": {
          "amount": {
            "description": "Amount in IDR (min 10,000)",
            "example": 1000000,
            "minimum": 10000.00,
            "type": "number"
          },
          "description": {
            "description": "Free-text note (max 255)",
            "example": "Bayar makan siang",
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "fromAccountId": {
            "description": "Source account — must be the caller's own account",
            "example": "3f1c2a9e-8b7d-4c3a-9e2f-1a2b3c4d5e6f",
            "format": "uuid",
            "type": "string"
          },
          "toAccountId": {
            "description": "Destination account",
            "example": "9b2e4f6a-1c3d-4e5f-8a7b-6c5d4e3f2a1b",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "fromAccountId",
          "toAccountId"
        ],
        "type": "object"
      },
      "TransferResponse": {
        "description": "Transfer and its processing status",
        "properties": {
          "amount": {
            "description": "Amount in IDR",
            "example": 1000000.0,
            "type": "number"
          },
          "createdAt": {
            "description": "Creation time",
            "example": "2026-02-25T10:15:30",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "Free-text note",
            "example": "Bayar makan siang",
            "type": "string"
          },
          "fraudCheckStatus": {
            "description": "Fraud check outcome",
            "enum": [
              "PENDING",
              "PASSED",
              "FLAGGED"
            ],
            "example": "PENDING",
            "type": "string"
          },
          "fromAccountId": {
            "description": "Source account",
            "example": "3f1c2a9e-8b7d-4c3a-9e2f-1a2b3c4d5e6f",
            "format": "uuid",
            "type": "string"
          },
          "referenceNo": {
            "description": "Human-readable reference number",
            "example": "TXN17953207695290297",
            "type": "string"
          },
          "status": {
            "description": "PENDING until the fraud check finishes; then COMPLETED, REJECTED (fraud) or FAILED (insufficient funds at debit time)",
            "enum": [
              "PENDING",
              "COMPLETED",
              "REJECTED",
              "FAILED"
            ],
            "example": "PENDING",
            "type": "string"
          },
          "toAccountId": {
            "description": "Destination account",
            "example": "9b2e4f6a-1c3d-4e5f-8a7b-6c5d4e3f2a1b",
            "format": "uuid",
            "type": "string"
          },
          "transactionId": {
            "description": "Transaction ID",
            "example": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "Bearer Authentication": {
        "bearerFormat": "JWT",
        "description": "Paste the accessToken from POST /api/v1/auth/login",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Fund transfer and EOD reconciliation service.\n\nTransfers are asynchronous: `POST /api/v1/transfers` returns 202 with status `PENDING`; poll `GET /api/v1/transfers/{id}` until it becomes `COMPLETED`, `REJECTED` or `FAILED`.",
    "title": "MiniBank — Transaction Service API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/reconciliation/daily": {
      "get": {
        "description": "Produces an EOD report using advanced native SQL with SUM() OVER, LAG, LEAD window functions and CTEs",
        "operationId": "getDailyReport",
        "parameters": [
          {
            "description": "Report date (ISO yyyy-MM-dd)",
            "example": "2026-02-25",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationReport"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request: validation failed or a parameter is malformed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authenticated, but not allowed to access this resource"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "summary": "Generate daily reconciliation report (ADMIN)",
        "tags": [
          "Reconciliation"
        ]
      }
    },
    "/api/v1/transfers": {
      "post": {
        "description": "Submits a transfer from the caller's own account. Returns 202 Accepted with status PENDING — the fraud check and the debit/credit happen asynchronously via Redis Streams; poll GET /api/v1/transfers/{id} for the result",
        "operationId": "initiateTransfer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            },
            "description": "Accepted; status is PENDING until the fraud check completes"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request: validation failed or a parameter is malformed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authenticated, but not allowed to access this resource"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "summary": "Initiate a fund transfer",
        "tags": [
          "Transfer"
        ]
      }
    },
    "/api/v1/transfers/history": {
      "get": {
        "description": "Paginated transfers (sent and received) for an account. USER can only read their own account. Default sort: newest first",
        "operationId": "getHistory",
        "parameters": [
          {
            "description": "Account ID",
            "example": "3f1c2a9e-8b7d-4c3a-9e2f-1a2b3c4d5e6f",
            "in": "query",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Zero-based page index (0..N)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The size of the page to be returned",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": [
                "createdAt,DESC"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseTransferResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request: validation failed or a parameter is malformed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authenticated, but not allowed to access this resource"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "summary": "Get transaction history",
        "tags": [
          "Transfer"
        ]
      }
    },
    "/api/v1/transfers/{id}": {
      "get": {
        "description": "Current status of a transfer (PENDING, COMPLETED, REJECTED, FAILED). Only the sender, the recipient or an ADMIN can read it",
        "operationId": "getTransfer",
        "parameters": [
          {
            "description": "Transaction ID",
            "example": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request: validation failed or a parameter is malformed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authenticated, but not allowed to access this resource"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Resource not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "summary": "Get transfer status",
        "tags": [
          "Transfer"
        ]
      }
    }
  },
  "security": [
    {
      "Bearer Authentication": []
    }
  ],
  "servers": [
    {
      "description": "Generated server url",
      "url": "http://localhost:8082"
    }
  ],
  "tags": [
    {
      "description": "End-of-day reconciliation reports using advanced SQL with window functions",
      "name": "Reconciliation"
    },
    {
      "description": "Fund transfer operations — initiate, track, and view transaction history",
      "name": "Transfer"
    }
  ]
}
